# Základní URL adresa testované aplikace
BASE_URL=http://testovani.kitner.cz

# Nastavení prohlížeče a běhu testů
HEADLESS=true
BROWSER_TIMEOUT=30000

# Běžný testovací uživatel
TEST_USER_NAME="Test Tester"
